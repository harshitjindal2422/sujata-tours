<IfModule mod_rewrite.c>
    RewriteEngine On

    # Prevent direct access to sensitive configuration files and directories
    RewriteRule ^(\.env|\.git|composer\.(json|lock)|package(-lock)?\.json|artisan|storage/logs/.*|phpunit\.xml) - [F,L,NC]

    # Transparently route all traffic to Laravel's public directory
    RewriteCond %{REQUEST_URI} !^/public/
    RewriteRule ^(.*)$ public/$1 [L]
</IfModule>
